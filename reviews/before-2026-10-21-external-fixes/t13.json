      ],
      [
       "$|A|=|B|$ (bars on both sides)",
       "Square both sides."
      ],
      [
       "$|\\ldots|<a$, with $a>0$",
       "Between: $-a<\\ldots<a$. One band."
      ],
      [
       "$|\\ldots|>a$, with $a>0$",

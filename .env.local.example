# Copy to .env.local and fill in. Never commit .env.local.

# --- Accounts (Supabase → Project Settings → API) ---------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # secret: server only

# --- Selling -----------------------------------------------------------------
NEXT_PUBLIC_PRICE_LABEL=              # e.g. ₪990
NEXT_PUBLIC_CONTACT_EMAIL=            # shown while online payment isn't connected
PAYMENT_LINK=                         # the provider's hosted payment page (Grow / Cardcom / Stripe link)
PAYMENT_PROVIDER=                     # grow | cardcom | stripe
PAYMENT_WEBHOOK_SECRET=               # any long random string; also put it in the provider's webhook URL

# --- Videos (Bunny Stream → your library → API) ------------------------------
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=                        # secret: used by the upload script only
BUNNY_TOKEN_KEY=                      # secret: "Token authentication key" — makes video links expire

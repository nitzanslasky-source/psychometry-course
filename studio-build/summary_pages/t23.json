          "$x\\%$ of $y=y\\%$ of $x$",
          "$4\\%$ of $75=75\\%$ of $4=3$"
         ],
         [
          "the same part: flip the percents",
          "$45\\%$ of $N=30\\%$ of $T$: $\\ N:T=30:45=2:3$"
         ],
         [
          "the same whole: keep them",
          "$x=60\\%$ of $y$, $z=150\\%$ of $y$: $\\ z=250\\%$ of $x$"
         ],
         [
          "whole $\\times k$, percent $\\div k$",
          "$30\\%$ of $100=15\\%$ of $200$"
         ]
        ]
       }
      ],

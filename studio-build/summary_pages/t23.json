       "$p+q+\\frac{pq}{100}$: $\\;25-12-3=10\\%$"
      ],
      [
       "backwards",
       "$81\\%=243$, $\\ 1\\%=3$, $\\ 100\\%=300$"
      ]
     ]
    }
   ]
  },

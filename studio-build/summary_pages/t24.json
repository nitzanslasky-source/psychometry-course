     "rows": [
      [
       "Biggest overlap $=$ the **smaller** group",
       "$10$ and $9$: $\\;9$"
      ],
      [
       "When $A+B$ exceeds the total: smallest overlap $=A+B-$ total",
       "$10+9-15=4$"
      ],
      [
       "Not over the total? $\\;$ Smallest $=0$, never negative",
       "$5+12=17<20$: $\\;0$, not $-3$"
      ],
      [
       "No total written? Find a natural one",
       "$14$ h and $16$ h a day: $\\;14+16-24=6$"
      ],
      [
       "Percents: the whole is $100\\%$",
       "$45\\%+70\\%-100\\%=15\\%$"
      ],
      [
       "Fractions: the whole is $1$",
       "$\\frac14+\\frac34=1$: no overlap is forced"
      ]
     ]
    }

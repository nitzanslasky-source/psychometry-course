 "sections": [
  {
   "title": "The family",
   "span": "full",
   "blocks": [
    {
     "type": "table",
     "class": "methods",
     "head": [
      "Shape",
      "Sides",
      "Angles",
      "Diagonals",
      "Area"
     ],
     "rows": [
      [
       "Square",
       "all equal",
       "all $90°$",
       "equal, perpendicular, halve each other, $45°$ to the sides; $d=a\\sqrt2$",
       "$a^2=\\frac{d^2}{2}$"
      ],
      [
       "Rectangle",
       "opposite equal",
       "all $90°$",
       "equal, halve each other",
       "$a\\cdot b$"
      ],
      [
       "Parallelogram",
       "opposite equal and parallel",
       "opposite equal; neighbours add to $180°$",
       "halve each other",
       "$a\\cdot h$"
      ],
      [
       "Rhombus",
       "all equal",
       "opposite equal",
       "perpendicular, halve each other",
       "$\\frac{d_1\\cdot d_2}{2}$"
      ],
      [
       "Kite (deltoid)",
       "two pairs of equal neighbours",
       "one pair equal",
       "perpendicular; one is cut in half",
       "$\\frac{d_1\\cdot d_2}{2}$"
      ],
      [
       "Trapezoid",
       "one pair parallel (the bases)",
       "on each leg: $180°$",
       "—",
       "$\\frac{(a+b)\\cdot h}{2}$"
      ]
     ]
    }
   ]
